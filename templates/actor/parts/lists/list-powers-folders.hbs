{{#if usePowerFolders}}
<ul class="item-list power-folders">
    {{#if owner}}
    <li class="item flexrow item-header">
        <div class="item-name" style="flex: 0 0 70%;">{{localize 'T20.Powers'}}</div>
        <div class="item-activation" style="flex: 0.7; text-align: left; white-space: nowrap;">{{localize 'T20.Activation'}}</div>
        <div class="item-controls flexrow" style="flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 4px; white-space: nowrap;">
            <a class="item-control toggle-power-folders" title="Desativar Agrupamento">
                <i class="fas fa-toggle-on"></i>
            </a>
            <a class="item-control folder-create" title="Novo Agrupador" style="color: #28a745;">
                <i class="fas fa-folder-plus"></i>
            </a>
            <a class="item-control item-create" title="Criar" data-type="poder" style="flex: 1;">
                <i class="fas fa-plus"></i> Criar
            </a>
        </div>
    </li>
    {{/if}}

    {{#each actor.powerFolders as |folder|}}
    <li class="power-folder" data-folder-id="{{folder.id}}" data-folder-order="{{folder.order}}">
        <div class="folder-header flexrow" data-folder-id="{{folder.id}}" {{#if folder.color}}style="background-color: {{folder.color}}; border-color: {{folder.color}};"{{/if}}>
            <div class="folder-title-wrapper" data-action="toggle-folder">
                <span class="folder-toggle">
                    <i class="fas {{#if folder.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
                </span>
                <span class="folder-name" title="{{folder.name}}">{{folder.name}}</span>
            </div>
            
            {{#if ../owner}}
            <div class="folder-controls">
                <a class="folder-control" data-action="rename-folder" title="Renomear">
                    <i class="fas fa-edit"></i>
                </a>
                <a class="folder-control folder-drag-handle" title="Arrastar">
                    <i class="fas fa-grip-vertical"></i>
                </a>
                <a class="folder-control" data-action="delete-folder" title="Excluir">
                    <i class="fas fa-trash"></i>
                </a>
            </div>
            {{/if}}
        </div>

        {{#unless folder.collapsed}}
        <ul class="folder-contents" data-folder-id="{{folder.id}}">
            {{#each folder.powers as |item index|}}
            <li class="item flexrow power-item" data-item-id="{{item._id}}" data-item-index="{{index}}" draggable="true">
                <div class="item-name flexrow rollable" data-label="{{item.name}}">
                    <div class="item-image" style="background-image: url('{{item.img}}')"></div>
                    <label>{{item.name}}</label>
                </div>
                <div class="item-activation">{{t20-itemLabels item}}</div>
                {{#if ../../owner}}
                {{> "tormenta20.actor-item-controls" item=item }}
                {{/if}}
            </li>
            {{else}}
            <li class="folder-empty"><em>Arraste poderes para cá</em></li>
            {{/each}}
        </ul>
        {{/unless}}
    </li>
    {{/each}}

    <li class="loose-powers-container">
        <div class="loose-header"><i class="fas fa-list" style="padding: 4px 5px;"></i> Poderes não agrupados</div>
        <ul class="item-list" style="margin:0; padding:0;">
        {{#if actor.loosePowers}}
            {{#each actor.loosePowers as |item index|}}
            <li class="item flexrow power-item loose-power" data-item-id="{{item._id}}" data-item-index="{{index}}" draggable="true">
                <div class="item-name flexrow rollable" data-label="{{item.name}}">
                    <div class="item-image" style="background-image: url('{{item.img}}')"></div>
                    <label>{{item.name}}</label>
                </div>
                <div class="item-activation">{{t20-itemLabels item}}</div>
                {{#if ../owner}}
                {{> "tormenta20.actor-item-controls" item=item }}
                {{/if}}
            </li>
            {{/each}}
        {{else}}
            <li class="folder-empty" style="padding: 10px; text-align: center; font-style: italic; color: #777;">
                <em>Arraste poderes para cá</em>
            </li>
        {{/if}}
        </ul>
    </li>
</ul>

{{else}}
<ul class="item-list">
    <li class="item flexrow item-header">
        <div class="item-name" style="flex: 0 0 32%;">{{localize 'T20.Powers'}}</div>
        <div class="item-type" style="flex: 1; text-align: center;">{{localize 'T20.Type'}}</div>
        <div class="item-activation" style="flex: 0.7; text-align: left;">{{localize 'T20.Activation'}}</div>
        {{#if owner}}
        <div class="item-controls flexrow" style="flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 4px; white-space: nowrap;">
            <a class="item-control toggle-power-folders" title="Ativar Agrupamento">
                <i class="fas fa-toggle-off"></i>
            </a>
            <a class="item-control item-create" title="Criar" data-type="poder" style="flex: 1;">
                <i class="fas fa-plus"></i> Criar
            </a>
        </div>
        {{/if}}
    </li>
    {{#each actor.poderes as |item id|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
        <div class="item-name flexrow rollable flex2" data-label="{{item.name}}">
            <div class="item-image" style="background-image: url('{{item.img}}')"></div>
            <label>{{item.name}}</label>
        </div>
        <div class="item-type">
            {{item.labels.tipo}}{{#if item.labels.subtipo}}: {{item.labels.subtipo}}{{/if}}
        </div>
        <div class="item-activation">
            {{t20-itemLabels item}}
        </div>
        {{#if ../owner}}
        {{> "tormenta20.actor-item-controls" item=item }}
        {{/if}}
    </li>
    {{/each}}
</ul>
{{/if}}
